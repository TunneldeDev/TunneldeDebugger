+/** Private development contract; never a stable plugin/local API. */
+export interface DebugParameters {
+  preset: "normal" | "empty" | "loading" | "error" | "boundary" | "disabled";
+  theme: "dark" | "light";
+  locale: "zh-CN" | "en-US";
+  width: number;
+  height: number;
+  count: number;
+  seed: number;
+}
