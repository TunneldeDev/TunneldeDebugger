+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Apply {
+    generation: u64,
+    scenario_id: String,
+    parameters: Parameters,
+}
+#[derive(Default)]
+struct Inner {
+    generation: u64,
+    request: Option<Value>,
+    ready: bool,
+    preparing: bool,
+    error: Option<String>,
